NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000,http://localhost:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urban_byte_db
DB_USER=root
DB_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m

# Optional road-routing provider. The public OSRM demo is for development/testing only.
# Production should use a compliant hosted or self-hosted OSRM endpoint.
DELIVERY_ROUTING_BASE_URL=https://router.project-osrm.org

# Set these only temporarily when creating the first administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Meta WhatsApp Cloud API webhook configuration (keep real values private)
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_RESTAURANT_ID=1
WHATSAPP_BRANCH_ID=1
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0

JWT_REFRESH_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_RESTAURANT_NAME=Urban Byte
SEED_ADMIN_NAME=Urban Byte Owner
SEED_ADMIN_EMAIL=owner@urbanbyte.local
SEED_ADMIN_PASSWORD=