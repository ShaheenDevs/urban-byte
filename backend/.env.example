NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000,http://localhost:8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urban_byte_db
DB_USER=urban_byte_user
DB_PASSWORD=replace_with_a_strong_local_password
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m

# Set these only temporarily when creating the first administrator.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Meta WhatsApp Cloud API webhook configuration (keep real values private)
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_webhook_verification_token
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
WHATSAPP_RESTAURANT_ID=1
WHATSAPP_BRANCH_ID=1
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
